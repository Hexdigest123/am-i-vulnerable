[Unit]
Description=cvewatch - prueft regelmaessig neue CVEs (RSS-Feed + Mistral KI) gegen installierte Pakete und patcht automatisch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cvewatch
Environment=CVEWATCH_CONFIG=/etc/cvewatch/cvewatch.ini
EnvironmentFile=-/etc/cvewatch/cvewatch.env
ExecStart=/usr/bin/python3 -m cvewatch run
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target
