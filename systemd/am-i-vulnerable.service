[Unit]
Description=Am I Vulnerable vulnerability watcher
Documentation=https://github.com/Hexdigest123/am-i-vulnerable
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/am-i-vulnerable
Restart=on-failure
RestartSec=10s

# The daemon needs root only to run the package manager; everything else is
# locked down so a bug in the network-facing parser cannot become root RCE.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETGID CAP_SETUID CAP_SETFCAP CAP_SYS_CHROOT CAP_MKNOD CAP_KILL CAP_AUDIT_WRITE
ProtectSystem=strict
ProtectHome=yes
# The package managers write below /var and /run; /etc stays read-only (the
# daemon treats a missing/unwritable config as a configuration error).
ReadWritePaths=/var /run
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
